# Required secrets (generate your own secure values)
LONG_TOKEN_SECRET= write your lonkq token secret here
SHORT_TOKEN_SECRET= write your short token secret here
NACL_SECRET= write your nacl secret here

# Optional configuration (will use defaults if not set)
SERVICE_NAME=axion
USER_PORT=3000
ADMIN_PORT=5222
ENV=development
REDIS_URI=redis://127.0.0.1:6379
MONGO_URI=write your mongo uri here
